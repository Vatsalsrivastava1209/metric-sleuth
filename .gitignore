# ──────────────────────────────────────────────────────────────────────────────
# MetricSleuth — .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Python Cache ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual Environments ───────────────────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ── Secrets & Environment Variables ───────────────────────────────────────────
.env
.env.*
*.env
secrets.toml
!.env.example          # allow an example env file to be committed

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/            # local Streamlit config (credentials, secrets)

# Streamlit Cloud deploy — KEEP these:
# .streamlit/config.toml  ← uncomment if you want to commit Streamlit config
# .streamlit/secrets.toml is auto-ignored above via secrets.toml

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Data ──────────────────────────────────────────────────────────────────────
# Keep sample CSV, ignore everything else under data/
data/*
!data/sample_ecommerce.csv

# Generated outputs (reports saved by report_generator)
output/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── ML / Model artifacts ──────────────────────────────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.pth
models/

# ── Build / Distribution ──────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
site/
pip-wheel-metadata/
MANIFEST

# ── Testing & Coverage ────────────────────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.pytest_cache/
pytest.ini
nosetests.xml

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.dmypy.json

# ── OS Artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Temporary Files ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
tmp/

# ── Profiling ─────────────────────────────────────────────────────────────────
*.prof
*.lprof
